function ANTI.Trigger()
    if ANTI.running or HUB.dead or HUB.paused then return end
    ANTI.running = true

    local char = LocalPlayer.Character
    if not char then ANTI.running = false return end
        
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local cam = Workspace.CurrentCamera

    if not root or not hum or not cam then ANTI.running = false return end

    local oldCamType = cam.CameraType
    local oldCamCF = cam.CFrame

    cam.CameraType = Enum.CameraType.Scriptable
    hum.BreakJointsOnDeath = false
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("Motor6D") then
            d.Enabled = true
        end
    end

    for _, cf in ipairs(ANTI.positions) do
        hum.PlatformStand = true
        hum.Health = 100
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        cam.CFrame = oldCamCF
        task.wait(0.02)
    end

    local lastCF = ANTI.positions[#ANTI.positions]
    local hbConn
    hbConn = RunService.Heartbeat:Connect(function()
        if not char or not root or not hum then return end
        hum.Health = 100
        hum.PlatformStand = true
        root.CFrame = lastCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        cam.CFrame = oldCamCF
    end)

    task.wait(0.35)

    if hbConn then hbConn:Disconnect() end
    hum.PlatformStand = false
    cam.CameraType = oldCamType
    cam.CameraSubject = hum
    
    ANTI.running = false
end

