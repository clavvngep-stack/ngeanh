local ALL_RARITIES = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cosmic", "Secret", "Eternal", "Divine"}
local RARITY_MAP = {
    Common=1, Uncommon=2, Rare=3, Epic=4, Legendary=5,
    Mythic=6, Cosmic=7, Secret=8, Eternal=9, Divine=10
}

local function resolveRarity(category)
    if type(category) ~= "string" or not AssetsData or type(AssetsData.Directory) ~= "table" then return nil end
    local item = AssetsData.Directory[category]
    local rarity = item and item.Rarity
    if not rarity then return nil end
    return rarity._id or rarity.DisplayName
end

local function getAreaEggs()
    if not EggStateAPI.GetAreaEggSnapshot then return {} end
    local snap = EggStateAPI.GetAreaEggSnapshot()
    if type(snap) ~= "table" or type(snap.Records) ~= "table" then return {} end
    
    local records = {}
    for _, rec in pairs(snap.Records) do
        if type(rec) == "table" and type(rec.Uid) == "string" then
            table.insert(records, rec)
        end
    end
    return records
end

local function isStealCandidate(eggRecord)
    if type(eggRecord) ~= "table" or type(eggRecord.Uid) ~= "string" then return false end
    if eggRecord.State ~= "Slot" and eggRecord.State ~= "Dropped" then return false end
    
    local areaOk = false
    if eggRecord.AreaId and CONFIG.SelectedAreas[eggRecord.AreaId] then areaOk = true end
    
    local rarityOk = false
    local rarity = resolveRarity(eggRecord.AssetCategory)
    if rarity and CONFIG.SelectedRarities[rarity] then rarityOk = true end

    return areaOk and rarityOk
end

local function getSlotEggPosition(slotInstance)
    local part = slotInstance:FindFirstChild("Hitbox") 
        or slotInstance:FindFirstChild("CustomBoundingBox") 
        or slotInstance:FindFirstChildOfClass("BasePart")
    if part then return part.Position end
    return slotInstance:GetPivot().Position
end

local function pickStealTarget()
    local slots = areaEggSlotsClient and areaEggSlotsClient:GetChildren() or {}
    if #slots == 0 then return nil end
    
    local eggMap = {}
    for _, rec in ipairs(getAreaEggs()) do
        if type(rec.Uid) == "string" then eggMap[rec.Uid] = rec end
    end
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    local bestSlot = nil
    local bestScore = -math.huge
    
    for _, slot in ipairs(slots) do
        local rec = eggMap[slot.Name]
        if rec and isStealCandidate(rec) then
            local pos = getSlotEggPosition(slot)
            local dist = root and pos and (root.Position - pos).Magnitude or 99999
            local rarityName = resolveRarity(rec.AssetCategory) or "Common"
            local score = (RARITY_MAP[rarityName] or 0) * 100000 - dist
            
            if score > bestScore then
                bestScore = score
                bestSlot = slot
            end
        end
    end
    
    return bestSlot
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function bypassMoveTo(targetPos, speed)
    speed = speed or 1000
    local char = LocalPlayer.Character
    local root = getRoot()
    if not char or not root then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.PlatformStand = true end
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = root.CFrame
    bg.Parent = root
    
    local noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
    
    local arrived = false
    local timeout = os.clock() + 15
    local lastPos = root.Position
    local timeStuck = 0
    
    while CONFIG.AutoStealEnabled and os.clock() < timeout do
        root = getRoot()
        if not root then break end
        
        local currentPos = root.Position
        local diff = targetPos - currentPos
        if diff.Magnitude <= 4 then arrived = true; break end
        
        if (currentPos - lastPos).Magnitude < 0.2 then
            timeStuck = timeStuck + RunService.Heartbeat:Wait()
            if timeStuck > 2 then break end
        else
            timeStuck = 0
        end
        lastPos = currentPos
        
        local dir = diff.Unit
        bv.Velocity = dir * speed
        bg.CFrame = CFrame.lookAt(currentPos, currentPos + Vector3.new(dir.X, 0, dir.Z))
        RunService.Heartbeat:Wait()
    end
    
    noclipConn:Disconnect()
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
    if hum and hum.Health > 0 then hum.PlatformStand = false end
    
    root = getRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    
    return arrived
end

local function tryCarryEgg(slotInstance)
    if not slotInstance or not EggStateAPI.RequestCarryAreaEgg then return false end
    local uid = slotInstance.Name
    local slotKey = nil
    
    if AreaEggSlotIdentityAPI.IsFirstAreaUid and AreaEggSlotIdentityAPI.IsFirstAreaUid(uid) then
        for _, rec in ipairs(getAreaEggs()) do
            if rec.Uid == uid and AreaEggSlotIdentityAPI.BuildSlotKey then
                slotKey = AreaEggSlotIdentityAPI.BuildSlotKey(rec.AreaId, rec.NestId)
                break
            end
        end
    end
    
    local ok, res = pcall(function() return EggStateAPI.RequestCarryAreaEgg(uid, slotKey) end)
    return ok and res == true
end

local function stealEgg(slotInstance)
    local root = getRoot()
    local targetPos = getSlotEggPosition(slotInstance)
    if not root or not targetPos then return false end
    
    local arrived = bypassMoveTo(targetPos, 1000)
    if not arrived or not CONFIG.AutoStealEnabled then return false end
    
    root = getRoot()
    if root then root.CFrame = CFrame.new(targetPos) end
    
    task.wait(0.5) 
    tryCarryEgg(slotInstance)
    
    root = getRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
    end
    
    task.wait(5)
    
    if not CONFIG.AutoStealEnabled then
        root = getRoot()
        if root then root.Anchored = false end
        return false 
    end
    
    root = getRoot()
    if root then root.Anchored = false end
    
    tryCarryEgg(slotInstance)
    task.wait(0.5)
    
    bypassMoveTo(Vector3.new(514, 150, -368), 700)
    task.wait(0.5)
    task.wait(2)
   
    return true
end

local isProcessingEgg = false 

task.spawn(function()
    while true do
        task.wait(1.5)
        
        if CONFIG.AutoStealEnabled and not isProcessingEgg then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 then
                local target = pickStealTarget()
                
                if target and target.Parent then
                    isProcessingEgg = true
                    stealEgg(target)
                    isProcessingEgg = false
                end
            end
        end
    end
end)

