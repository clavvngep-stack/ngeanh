local tpWalkEnabled = false
local stepMultiplier = 0.2
local tpConnection
createToggleSwitch(MainTab, "TPWalk", false, function(state)
	tpWalkEnabled = state
	if tpWalkEnabled then
		tpConnection = RunService.RenderStepped:Connect(function(dt)
			local character = LocalPlayer.Character
			if not character then return end
			local humanoid = character:FindFirstChild("Humanoid")
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if not humanoid or not rootPart then return end
			if humanoid.MoveDirection.Magnitude > 0 then
				local baseSpeed = math.min(humanoid.WalkSpeed, 100)
				local currentMove = humanoid.MoveDirection * (baseSpeed * stepMultiplier) * dt
				local dynamicLimit = math.max(0.8, stepMultiplier * 2.5)
				if currentMove.Magnitude > dynamicLimit then
					currentMove = currentMove.Unit * dynamicLimit
				end
				rootPart.CFrame = rootPart.CFrame + currentMove
			end
		end)
	else
		if tpConnection then tpConnection:Disconnect(); tpConnection = nil end
	end
end)

createSlider(MainTab, "TPWalk Speed", 0, 10.0, 0.2, "TPWalk Speed: %.2f", function(val)
	stepMultiplier = val
end)

local batAuraEnabled = false
local batAuraConn = nil
local batAuraLast = tick()
local batAuraDistance = 16.5

local function createSeed()
	local s, r = pcall(function()
		return ("%*:%*:%*"):format(LocalPlayer.UserId, 100, (math.floor(Workspace:GetServerTimeNow() * 1000)))
	end)
	if s and r then return r end
	return nil
end

createToggleSwitch(MainTab, "Bat Aura", false, function(state)
	batAuraEnabled = state
	if state then
		local networking = ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking")
		local batSwingTrigger = networking and networking:FindFirstChild("RE/BatSwing/Trigger")
		local clientFolder = ReplicatedStorage:FindFirstChild("Client")
		local toolGameplayGuard = clientFolder and require(clientFolder:FindFirstChild("ToolGameplayGuard"))

		if not batSwingTrigger or not toolGameplayGuard then
			warn("Bat Aura gagal: Remote atau Guard tidak ditemukan!")
			return
		end

		batAuraConn = RunService.Heartbeat:Connect(function()
			if not batAuraEnabled then return end
			local target = nil
			local cd = math.huge
			for _, p in next, Players:GetPlayers() do
				if p == LocalPlayer then continue end
				local char = p.Character
				if not char then continue end
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if not hrp then continue end
				local dist = LocalPlayer:DistanceFromCharacter(hrp.Position)
				if dist < cd and dist <= batAuraDistance then
					cd = dist
					target = p
				end
			end
			if target and (tick() - batAuraLast >= 0.1) then
				pcall(function()
					batSwingTrigger:FireServer(target, createSeed())
				end)
				batAuraLast = tick()
			end
		end)
	else
		if batAuraConn then batAuraConn:Disconnect(); batAuraConn = nil end
	end
end)

createSlider(MainTab, "Bat Aura Distance", 1, 50, 16.5, "Bat Aura Distance: %.1f", function(val)
