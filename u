local pickFn = function(tbl, ...)
    if type(tbl) ~= "table" then return nil end
    for i = 1, select("#", ...) do
        local fnName = select(i, ...)
        if type(tbl[fnName]) == "function" then return tbl[fnName] end
    end
    return nil
end

