local function requirePath(parent, timeout, ...)
    local curr = parent
    for _, name in ipairs({...}) do
        if not curr then return nil end
        curr = curr:FindFirstChild(name) or curr:WaitForChild(name, timeout or 4)
    end
    if not curr then return nil end
    local ok, res = pcall(require, curr)
    return ok and res or nil
end

local function findModule(name)
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("ModuleScript") and v.Name == name then
            local ok, res = pcall(require, v)
            if ok then return res end
        end
    end
    return nil
end

