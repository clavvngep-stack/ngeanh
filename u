local apexEggStateModule = requirePath(ReplicatedStorage, 6, "Client", "EggState") or findModule("EggState")
local apexAreaEggSlotIdentityModule = requirePath(ReplicatedStorage, 4, "Shared", "Util", "AreaEggSlotIdentity") or findModule("AreaEggSlotIdentity")
local apexAssetsDataModule = requirePath(ReplicatedStorage, 4, "Data", "Assets") or findModule("Assets")

local apexGetAreaEggSnapshot = pickFn(apexEggStateModule, "ReadFieldEggs", "GetAreaEggSnapshot")
local apexIsFirstAreaUid = pickFn(apexAreaEggSlotIdentityModule, "LooksLikeFirstAreaUid", "IsFirstAreaUid")
local apexBuildSlotKey = pickFn(apexAreaEggSlotIdentityModule, "SlotKey", "BuildSlotKey")

local function apexRarityName(assetCat)
	if type(assetCat) ~= "string" or not apexAssetsDataModule or type(apexAssetsDataModule.Directory) ~= "table" then return "Common" end
	local item = apexAssetsDataModule.Directory[assetCat]
	local rarity = item and item.Rarity
	if not rarity then return "Common" end
	return rarity._id or rarity.DisplayName or "Common"
end

local function apexAssetName(assetCat)
	if apexAssetsDataModule and type(apexAssetsDataModule.Directory) == "table" then
		local item = apexAssetsDataModule.Directory[assetCat or ""]
		if item and item.DisplayName then return item.DisplayName end
	end
	return tostring(assetCat or "Unknown Egg")
end

local function apexRarityColor(rarityName)
	local map = {
		Common = Color3.fromRGB(200, 200, 200),
		Uncommon = Color3.fromRGB(120, 220, 120),
		Rare = Color3.fromRGB(80, 160, 255),
		Epic = Color3.fromRGB(170, 90, 255),
		Legendary = Color3.fromRGB(255, 180, 50),
		Mythic = Color3.fromRGB(255, 90, 180),
		Cosmic = Color3.fromRGB(120, 240, 255),
		Secret = Color3.fromRGB(255, 70, 70),
		Eternal = Color3.fromRGB(50, 255, 200),
		Divine = Color3.fromRGB(255, 220, 100),
	}
	return map[tostring(rarityName)] or Color3.fromRGB(255, 255, 255)
end

local function apexFindEggSlotInstance(eggRec)
	local uid = eggRec and eggRec.Uid
	if not uid then return nil end
	local areaSlots = Workspace:FindFirstChild("AreaEggSlotsClient")
	if not areaSlots then return nil end

	local isFirst = apexIsFirstAreaUid and apexIsFirstAreaUid(uid)
	local slotKey = nil
	if isFirst and apexBuildSlotKey and eggRec.AreaId and eggRec.NestId then
		slotKey = apexBuildSlotKey(eggRec.AreaId, eggRec.NestId)
	end

	for _, slot in ipairs(areaSlots:GetChildren()) do
		if slot.Name == uid or (slotKey and slot.Name == slotKey) then
			return slot
		end
	end
	return nil
end

local function apexClearEggEsp()
	if apexEggEspFolder then
		apexEggEspFolder:ClearAllChildren()
	end
end

local function apexUpdateEggEsp()
	if not eggESPEnabled then
		apexClearEggEsp()
		return
	end

	if not apexGetAreaEggSnapshot then return end
	local snap = apexGetAreaEggSnapshot()
	if type(snap) ~= "table" or type(snap.Records) ~= "table" then return end

	local activeUids = {}

	for _, rec in pairs(snap.Records) do
		if type(rec) == "table" and type(rec.Uid) == "string" then
			local state = rec.State
			if state == "Slot" or state == "Dropped" then
				local uid = rec.Uid
				activeUids[uid] = true

				local slotInst = apexFindEggSlotInstance(rec)
				local adorneePart = slotInst and (
					slotInst:FindFirstChild("Hitbox") 
					or slotInst:FindFirstChild("CustomBoundingBox") 
					or slotInst:FindFirstChildOfClass("BasePart")
				)

				if adorneePart then
					local billboard = apexEggEspFolder:FindFirstChild(uid)
					if not billboard then
						billboard = Instance.new("BillboardGui")
						billboard.Name = uid
						billboard.Size = UDim2.new(0, 120, 0, 140) 
						billboard.StudsOffset = Vector3.new(0, 6, 0)
						billboard.AlwaysOnTop = true
						billboard.Parent = apexEggEspFolder

						local imageBadge = Instance.new("ImageLabel")
						imageBadge.Name = "ImageBadge"
						imageBadge.Size = UDim2.new(1, 0, 0.75, 0)
						imageBadge.Position = UDim2.new(0, 0, 0, 0)
						imageBadge.BackgroundTransparency = 1
						imageBadge.ScaleType = Enum.ScaleType.Fit
						imageBadge.Parent = billboard

						local label = Instance.new("TextLabel")
						label.Name = "ESPLabel"
						label.Size = UDim2.new(1, 0, 0.25, 0)
						label.Position = UDim2.new(0, 0, 0.75, 0)
						label.BackgroundTransparency = 1
						label.Font = Enum.Font.GothamBold
						label.TextSize = 16
						label.TextStrokeTransparency = 0.1
						label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
						label.Parent = billboard
					end

					billboard.Adornee = adorneePart
					local label = billboard:FindFirstChild("ESPLabel")
					local imageBadge = billboard:FindFirstChild("ImageBadge")

					if label and imageBadge then
						local nameStr = apexAssetName(rec.AssetCategory)
						local rarityStr = apexRarityName(rec.AssetCategory)
						
						label.Text = nameStr .. " [" .. rarityStr .. "]"
						label.TextColor3 = apexRarityColor(rarityStr)
						
						if apexAssetsDataModule and type(apexAssetsDataModule.Directory) == "table" then
							local itemData = apexAssetsDataModule.Directory[rec.AssetCategory]
							if itemData then
								local imgData = itemData.Image or itemData.Icon or itemData.Thumbnail
								if imgData then
									imageBadge.Image = imgData
								end
							end
						end
					end
				else
					local billboard = apexEggEspFolder:FindFirstChild(uid)
					if billboard then billboard:Destroy() end
				end
			end
		end
	end

	for _, child in ipairs(apexEggEspFolder:GetChildren()) do
		if child:IsA("BillboardGui") and not activeUids[child.Name] then
			child:Destroy()
		end
	end
end

