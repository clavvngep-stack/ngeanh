local isMoving = false
local TPWALK_TRAVEL_SPEED = 25.0
local ARRIVE_DISTANCE = 4
local MAX_TRAVEL_TIME = 120
local walkToken = 0
local activeWalkConnection = nil

local function stopFastTravel()
	walkToken = walkToken + 1
	if activeWalkConnection then
		activeWalkConnection:Disconnect()
		activeWalkConnection = nil
	end
	isMoving = false
end

local function resolveGuardPosition(areaName)
	local cleanQuery = string.lower(areaName):gsub("[%s%_%-]", "")
	local bestCandidatePos = nil
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Folder") or desc:IsA("Model") then
			local cleanName = string.lower(desc.Name):gsub("[%s%_%-]", "")
			if cleanName == cleanQuery or cleanName:find(cleanQuery) then
				local guard = desc:FindFirstChild("Guard") or desc:FindFirstChild("Spawn") or desc:FindFirstChild("Part")
				if guard then
					if guard:IsA("BasePart") then bestCandidatePos = guard.Position; break
					elseif guard:IsA("Model") then
						local ok, cf = pcall(function() return guard:GetPivot() end)
						if ok and cf then bestCandidatePos = cf.Position; break end
					end
				end
				local ok, cf = pcall(function() return desc:GetPivot() end)
				if ok and cf and cf.Position.Magnitude > 0 then bestCandidatePos = cf.Position end
			end
		end
	end
	return bestCandidatePos
end

local function travelToTarget(targetPos, onFinished)
	local char = LocalPlayer.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then return end
	stopFastTravel()
	walkToken = walkToken + 1
	local myToken = walkToken
	isMoving = true
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {char}
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	local rayResult = Workspace:Raycast(targetPos + Vector3.new(0, 150, 0), Vector3.new(0, -300, 0), raycastParams)
	local groundPos = rayResult and rayResult.Position or targetPos
	
	local startTime = tick()
	activeWalkConnection = RunService.RenderStepped:Connect(function(dt)
		if myToken ~= walkToken then return end
		if not char.Parent or not root.Parent or not humanoid.Parent then stopFastTravel(); return end
		
		local currentPos = root.Position
		local flatCurrent = Vector3.new(currentPos.X, 0, currentPos.Z)
		local flatTarget = Vector3.new(groundPos.X, 0, groundPos.Z)
		local distanceVector = flatTarget - flatCurrent
		local distance = distanceVector.Magnitude
		
		if distance <= ARRIVE_DISTANCE or (tick() - startTime) > MAX_TRAVEL_TIME then
			stopFastTravel()
			if onFinished then onFinished() end
			return
		end
		
		local direction = distanceVector.Unit
		local moveStep = direction * (TPWALK_TRAVEL_SPEED * 20) * dt
		if moveStep.Magnitude > distance then
			root.CFrame = CFrame.new(groundPos + Vector3.new(0, 3, 0))
		else
			root.CFrame = root.CFrame + moveStep
		end
	end)
end

local function travelToGuard(areaName)
	local targetPos = resolveGuardPosition(areaName)
	if targetPos then travelToTarget(targetPos) end
end

