local function bypassMoveTo(targetPos, speed)
    speed = speed or 1000
    local char = LocalPlayer.Character
    local root = getRoot()
    if not char or not root then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.PlatformStand = true end
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = root.CFrame
    bg.Parent = root
    
    local noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
    
    local arrived = false
    local timeout = os.clock() + 15
    local lastPos = root.Position
    local timeStuck = 0
    
    while CONFIG.AutoStealEnabled and os.clock() < timeout do
        root = getRoot()
        if not root then break end
        
        local currentPos = root.Position
        local diff = targetPos - currentPos
        if diff.Magnitude <= 4 then arrived = true; break end
        
        if (currentPos - lastPos).Magnitude < 0.2 then
            timeStuck = timeStuck + RunService.Heartbeat:Wait()
            if timeStuck > 2 then break end
        else
            timeStuck = 0
        end
        lastPos = currentPos
        
        local dir = diff.Unit
        bv.Velocity = dir * speed
        bg.CFrame = CFrame.lookAt(currentPos, currentPos + Vector3.new(dir.X, 0, dir.Z))
        RunService.Heartbeat:Wait()
    end
    
    noclipConn:Disconnect()
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
    if hum and hum.Health > 0 then hum.PlatformStand = false end
    
    root = getRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    
    return arrived
end

local function tryCarryEgg(slotInstance)
    if not slotInstance or not EggStateAPI.RequestCarryAreaEgg then return false end
    local uid = slotInstance.Name
    local slotKey = nil
    
    if AreaEggSlotIdentityAPI.IsFirstAreaUid and AreaEggSlotIdentityAPI.IsFirstAreaUid(uid) then
        for _, rec in ipairs(getAreaEggs()) do
            if rec.Uid == uid and AreaEggSlotIdentityAPI.BuildSlotKey then
                slotKey = AreaEggSlotIdentityAPI.BuildSlotKey(rec.AreaId, rec.NestId)
                break
            end
        end
    end
    
    local ok, res = pcall(function() return EggStateAPI.RequestCarryAreaEgg(uid, slotKey) end)
    return ok and res == true
end

local function stealEgg(slotInstance)
    local root = getRoot()
    local targetPos = getSlotEggPosition(slotInstance)
    if not root or not targetPos then return false end
    
    local arrived = bypassMoveTo(targetPos, 1000)
    if not arrived or not CONFIG.AutoStealEnabled then return false end
    
    root = getRoot()
    if root then root.CFrame = CFrame.new(targetPos) end
    
    task.wait(0.5) 
    tryCarryEgg(slotInstance)
    
    root = getRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
    end
    
    task.wait(5)
    
    if not CONFIG.AutoStealEnabled then
        root = getRoot()
        if root then root.Anchored = false end
        return false 
    end
    
    root = getRoot()
    if root then root.Anchored = false end
    
    tryCarryEgg(slotInstance)
    task.wait(0.5)

    local carriedUid = slotInstance and slotInstance.Name
    if carriedUid and CONFIG.AntiDropEggEnabled and HUB.AntiEggDrop then
        HUB.AntiEggDrop.lockedUid = carriedUid
        HUB.V44.lockedUid = carriedUid
        if HUB.antiState then HUB.antiState.returnEggUid = carriedUid end
    end
    
    bypassMoveTo(Vector3.new(514, 150, -368), 700)
    task.wait(0.5)
    task.wait(2)
   
    return true
end

local isProcessingEgg = false 

task.spawn(function()
